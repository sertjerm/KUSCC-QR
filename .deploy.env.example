# File: .deploy.env.example
# Version: 1.0.0
# Description: ตัวอย่างค่าที่ build_prod.sh ใช้ deploy — copy เป็น .deploy.env แล้วกรอกค่าจริง (.deploy.env ถูก gitignore ห้าม commit)
# ใช้บัญชี SFTP เดียวกับโปรเจกต์อื่นใน ~/Dev/NetCore (ดู .deploy.env ของ KUSCC-CENTER)
# path ให้ตรงกับโฟลเดอร์ที่ IIS map ไว้กับ https://apps4.coop.ku.ac.th/kuscc-qr/

FTP_HOST=sftp://158.108.9.104
FTP_USER=your_ftp_username
FTP_PASS=your_ftp_password
FTP_PATH_CLIENT=/Products/NetCore/KUSCC-QR/client
FTP_PATH_API=/Products/NetCore/KUSCC-QR/api
# Optional: ถ้าไม่กำหนดจะใช้ parent ของ FTP_PATH_CLIENT
FTP_PATH_ROOT=/Products/NetCore/KUSCC-QR
